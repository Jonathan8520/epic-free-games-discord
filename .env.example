# Copie ce fichier en .env et remplis les valeurs.
# .env est gitignored — ne le commit JAMAIS.

# Obligatoire : webhook Discord pour les notifs
DISCORD_WEBHOOK=

# Optionnels
ROLE_ID=
ALERT_WEBHOOK=

# Auto-claim Epic (optionnel)
# AUTO_CLAIM=true
# EPIC_REFRESH_TOKEN=   # généré via `python test_claim.py --bootstrap <code>`
# GH_PAT=               # PAT fine-grained, scope secrets:write
